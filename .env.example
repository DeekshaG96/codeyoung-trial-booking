# ==============================================================================
# Kodaverse™ Full-Stack Environment Reference (.env.example)
# The Global 1:1 Coding & STEM Mentorship Platform
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Place in client/.env)
# ------------------------------------------------------------------------------
VITE_API_URL=/api
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Google Gemini API Key (Optional: for live LLM responses in Koda AI)
# Get a key from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Backend Server Configuration (Place in server/.env)
# ------------------------------------------------------------------------------
PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000,https://kodaverse-863ce.web.app
FIREBASE_PROJECT_ID=your-project-id
GEMINI_API_KEY=
JWT_SECRET=replace-with-a-long-random-secret
MAX_DAILY_DEMOS_PER_MENTOR=2
MENTOR_TIMEZONE=Asia/Kolkata
